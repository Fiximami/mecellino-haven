# Environment variables (example only — copy to `.env.local` for local use)
# Do not put real credentials in this file or in the repository.

# Public Auth configuration is optional. Public routes stay available when these
# are missing, empty or placeholders. Authentication then fails closed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional current official alias for the publishable/anonymous key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged credential. Never prefix with NEXT_PUBLIC_.
# Unused for ordinary user requests in this milestone. Leave unset.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only pooled PostgreSQL connection for the private audit adapter.
# Copy the transaction-pooler URL from Supabase Dashboard > Connect. The
# username or hostname must contain this project reference. Never commit the
# password or expose this variable to the browser.
SUPABASE_PROJECT_REF=
SUPABASE_DATABASE_URL=

# Canonical site origin (no trailing slash). Example placeholder only.
# Public pages remain available when this is missing or is the placeholder.
# Hosted authentication must not be enabled until this is an approved HTTPS
# origin. Host and X-Forwarded-Host headers are not a substitute.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
