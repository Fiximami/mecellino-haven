# Environment variables (example only — copy to `.env.local` for local use)

# Supabase (future authenticated milestones — not required for public-only operation)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production deployment requirement: public absolute URLs for canonical links and Open Graph metadata.
# Set this to your approved production site origin (no trailing slash).
# Example placeholder only — replace with the verified deployment domain before go-live.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
